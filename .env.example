# ============================================================
# Printer Agent – Environment Variables (.env)
# ============================================================
# Copy this file to .env and fill in your real values.
# This file is git-ignored so secrets stay local.
# ============================================================

# ── Core Admin Credentials ───────────────────────────────────
ADMIN_EMAIL=admin@printagent.com
ADMIN_PASSWORD=admin123

# IMPORTANT: Change this to a long random string in production!
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=please-change-this-secret-key-in-production

# ── Web Server ────────────────────────────────────────────────
WEB_HOST=0.0.0.0
WEB_PORT=8000

# ── Pricing (₹ INR) ──────────────────────────────────────────
PRICE_PER_PAGE_BW=5
PRICE_PER_PAGE_COLOR=10
SHOP_SUBSCRIPTION_MONTH=50

# ── Default UPI Payment Details ───────────────────────────────
# Replace with the platform owner's UPI VPA (used as fallback)
UPI_DEFAULT_VPA=malikprint@upi
UPI_MERCHANT_NAME=Printer Agent
